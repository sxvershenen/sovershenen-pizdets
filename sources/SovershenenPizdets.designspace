<?xml version='1.0' encoding='UTF-8'?>
<designspace format="5.0">
  <axes>
    <axis tag="wght" name="Weight" minimum="100" maximum="900" default="100">
      <map input="100" output="36"/>
      <map input="300" output="61.5"/>
      <map input="400" output="82.4"/>
      <map input="500" output="112.2"/>
      <map input="700" output="138.6"/>
      <map input="800" output="162.9"/>
      <map input="900" output="186.1"/>
    </axis>
    <axis tag="wdth" name="Width" minimum="100" maximum="125" default="100"/>
  </axes>
  <rules>
    <rule name="BRACKET.Weight_86_234">
      <conditionset>
        <condition name="Weight" minimum="86" maximum="234"/>
      </conditionset>
      <sub name="guarani" with="guarani.BRACKET.varAlt01"/>
      <sub name="dollar" with="dollar.BRACKET.varAlt01"/>
      <sub name="Q" with="Q.BRACKET.varAlt01"/>
      <sub name="peso" with="peso.BRACKET.varAlt01"/>
      <sub name="colonsign" with="colonsign.BRACKET.varAlt01"/>
