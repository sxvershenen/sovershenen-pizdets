      <sub name="guarani" with="guarani.BRACKET.varAlt01"/>
      <sub name="dollar" with="dollar.BRACKET.varAlt01"/>
      <sub name="Q" with="Q.BRACKET.varAlt01"/>
      <sub name="yen" with="yen.BRACKET.varAlt01"/>
    </rule>
    <rule name="BRACKET.Weight_48_234">
      <conditionset>
        <condition name="Weight" minimum="48" maximum="234"/>
      </conditionset>
      <sub name="yen" with="yen.BRACKET.varAlt01"/>
    </rule>
  </rules>
