      <sub name="Oslashacute" with="Oslashacute.BRACKET.varAlt01"/>
      <sub name="Oslash" with="Oslash.BRACKET.varAlt01"/>
      <sub name="yen" with="yen.BRACKET.varAlt01"/>
    </rule>
    <rule name="BRACKET.Weight_64_86">
      <conditionset>
        <condition name="Weight" minimum="64" maximum="86"/>
