sub leftOpenDialog dialog' by rightCloseDialog;
lookup infinitum1 {
	sub leftOpenDialog leftOpenDialog' by orn.016;
} infinitum1;
lookup infinitum2 {
	sub orn.016 leftOpenDialog' orn.016 by orn.016;
} infinitum2;
sub asterisk by asterisk.ss02;
sub bullet by bullet.ss02;
sub exclam by exclam.ss02;
sub bracketleft by bracketleft.ss02;
sub bracketright by bracketright.ss02;
sub parenleft by parenleft.ss02;
sub parenright by parenright.ss02;
sub bar by bar.ss02;
sub colon by orn.001;
sub period by orn.007;
sub [Q q] by orn.010;
sub [W w] by orn.021;
sub hyphen by orn.022;
} titl;
